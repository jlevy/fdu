# Cargo build output
target/
debug/

# rustfmt backups
**/*.rs.bk

# MSVC debug info
*.pdb

# Third-party source checked out for reference only, never built or shipped.
attic/

# Benchmark corpora and results are generated, often large, and machine-specific.
explorations/benchmarks/corpus/
explorations/benchmarks/results/

# Python build artifacts from maturin
*.so
*.pyd
dist/
!tests/golden/fixtures/project/dist/
!tests/golden/fixtures/project/dist/acorn-0.1.0.tar.gz
.venv/
.venv-smoke/
__pycache__/

# Node-based development tools
node_modules/

# Editors
.DS_Store
*.swp

# Backup files left by in-place rewriting tools: repren writes `<file>.orig` beside
# every file it changes, and a `git add -A` after a repo-wide rename will otherwise
# sweep all of them in — which happened once, at 71 files and 24,193 lines.
*.orig
*.rej

# The nominated subject set names real trees on this machine by absolute path, which
# is the one thing the loop never records. The redacted document `realtree subjects`
# emits from it is what gets committed.
explorations/benchmarks/subjects.local.json

# Real-tree benchmark scratch: clones of large external trees, kept out of git.
explorations/benchmarks/corpus/realtree/
tests/parity/.corpus/
