      },
      "required": [
        "ordinal",
        "sample_index",
        "sample_kind",
        "scenario_id"
      ],
      "type": "object"
    },
    "method": {
      "additionalProperties": false,
      "properties": {
        "order_algorithm": {
          "const": "sha256-round-robin-v1"
