{
  "$defs": {
    "corpus": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": false,
          "properties": {
            "directories": {
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "minimum": 0,
              "type": "integer"
            },
            "hardlink_groups": {
              "minimum": 0,
              "type": "integer"
            },
            "other": {
              "minimum": 0,
              "type": "integer"
            },
            "symlinks": {
              "minimum": 0,
              "type": "integer"
            },
            "total": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "directories",
            "files",
            "hardlink_groups",
            "other",
            "symlinks",
            "total"
          ],
          "type": "object"
        },
        "manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "recipe_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "recipe_id": {
          "pattern": "^[a-z0-9][a-z0-9._/-]*$",
          "type": "string"
        },
        "semantic_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "state": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "baseline",
                "one-change",
                "modify-1pct",
                "mixed-1pct"
              ]
            },
            "transition_index": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "transition_index"
          ],
          "type": "object"
        }
      },
      "required": [
        "counts",
        "manifest_hash",
        "recipe_hash",
        "recipe_id",
        "semantic_digest",
        "state"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "explicitly_unset": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "set": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "type": "object"
        }
      },
      "required": [
        "explicitly_unset",
        "set"
      ],
      "type": "object"
    },
    "executable_identity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "identity_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "components",
        "identity_hash"
      ],
      "type": "object"
    },
    "host_class": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "cpu_logical": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "filesystem_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_class": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "memory_bytes": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "operating_system": {
          "type": "string"
        }
