        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "validation": {
          "$ref": "#/$defs/trial_validation"
        }
      },
      "required": [
        "argv",
        "corpus",
        "environment",
        "filesystem_cache_state",
        "ordinal",
        "output",
        "probe_metrics",
        "process",
        "resources",
        "sample_index",
        "sample_kind",
        "scenario_id",
        "snapshot_state",
        "timing",
