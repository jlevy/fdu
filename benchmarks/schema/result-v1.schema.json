        "order_seed": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "order_algorithm",
        "order_seed"
      ],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
