#!/usr/bin/env python3
# Ported: the lock file is $REVIEW/timing.lock (the original's location) instead of a path relative to the script.
"""Run a command while holding the shared exclusive timing lock (blocks until free)."""
import fcntl, os, subprocess, sys, time
lock = open(os.path.join(os.environ["REVIEW"], "timing.lock"), "a+")
t0 = time.monotonic()
fcntl.flock(lock, fcntl.LOCK_EX)
waited = time.monotonic() - t0
if waited > 1:
    print(f"[timing-lock] waited {waited:.1f}s", file=sys.stderr)
sys.exit(subprocess.call(sys.argv[1:]))
